<Window x:Class="StlGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StlGen — pictures to STL" Height="820" Width="1280" MinWidth="900" MinHeight="600"
        Background="#F3F3F3">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="SlotTemplate">
            <Border Width="200" Margin="0,0,8,8" Padding="6" Background="White" BorderBrush="#D0D0D0" BorderThickness="1"
                    CornerRadius="4" AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="#666" TextWrapping="Wrap" />
                    <Border Height="140" Margin="0,4" Background="#EAEAEA">
                        <Grid>
                            <Image Source="{Binding Preview}" Stretch="Uniform" />
                            <TextBlock Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#999">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasImage}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding FileName}" FontSize="10" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <WrapPanel>
                        <Button Content="Load…" Click="Load_Click" Tag="{Binding}" />
                        <Button Content="⟳" ToolTip="Rotate 90° clockwise" Click="Rotate_Click" Tag="{Binding}"
                                IsEnabled="{Binding HasImage}" />
                        <Button Content="⇋" ToolTip="Mirror left/right" Click="Mirror_Click" Tag="{Binding}"
                                IsEnabled="{Binding HasImage}" />
                        <Button Content="✕" ToolTip="Remove image" Click="Clear_Click" Tag="{Binding}"
                                IsEnabled="{Binding HasImage}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="640" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: pictures and settings -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,4" Text="1. Add pictures of the object" />
                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                           Text="Photograph the object straight-on against a plain background that contrasts with it (or use images with a transparent background). Fill as many slots as you can — at least two different directions, ideally front, side and top. Use ⟳ / ⇋ to fix orientation so the picture matches the hint." />
                <ItemsControl x:Name="SlotsControl" ItemTemplate="{StaticResource SlotTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Style="{StaticResource SectionHeader}" Text="2. Background removal" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Colour tolerance" VerticalAlignment="Center" />
                    <Slider x:Name="ToleranceSlider" Grid.Column="1" Minimum="5" Maximum="250" Value="40"
                            TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Tolerance_Changed" />
                    <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=ToleranceSlider}" VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </Grid>
                <WrapPanel Margin="0,4,0,0">
                    <CheckBox x:Name="InvertCheck" Content="Invert" Margin="0,0,16,0" Click="Settings_Changed" />
                    <CheckBox x:Name="FillHolesCheck" Content="Fill holes" IsChecked="True" Margin="0,0,16,0"
                              Click="Settings_Changed" />
                    <CheckBox x:Name="LargestCheck" Content="Keep largest piece only" IsChecked="True" Margin="0,0,16,0"
                              Click="Settings_Changed" />
                    <CheckBox x:Name="ShowMaskCheck" Content="Highlight background" IsChecked="True" Click="Settings_Changed" />
                </WrapPanel>

                <TextBlock Style="{StaticResource SectionHeader}" Text="3. Size and detail" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Known dimension" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2">
                        <ComboBox x:Name="ScaleAxisCombo" Width="130" SelectedIndex="0">
                            <ComboBoxItem Content="Width (X)" />
                            <ComboBoxItem Content="Depth (Y)" />
                            <ComboBoxItem Content="Height (Z)" />
                        </ComboBox>
                        <TextBlock Text="=" Margin="8,0" VerticalAlignment="Center" />
                        <TextBox x:Name="ScaleSizeBox" Width="70" Text="100" VerticalContentAlignment="Center" />
                        <TextBlock Text="mm" Margin="4,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Detail (grid cells)" VerticalAlignment="Center" />
                    <Slider x:Name="ResolutionSlider" Grid.Row="1" Grid.Column="1" Minimum="32" Maximum="400" Value="160"
                            TickFrequency="8" IsSnapToTickEnabled="True" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=ResolutionSlider}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="GenerateButton" Content="Generate 3D shape" FontWeight="SemiBold" Padding="14,6"
                            Click="Generate_Click" />
                    <Button x:Name="SaveButton" Content="Save STL…" Padding="14,6" IsEnabled="False" Click="Save_Click" />
                </StackPanel>
                <ProgressBar x:Name="Progress" Height="6" Margin="0,8,0,0" Maximum="1" />
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Right: 3D preview -->
        <Border Grid.Column="2" Background="#2B2D31" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <Viewport3D x:Name="Viewport">
                    <Viewport3D.Camera>
                        <PerspectiveCamera x:Name="Camera" FieldOfView="40" UpDirection="0,0,1" />
                    </Viewport3D.Camera>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#404040" />
                                <DirectionalLight Color="#C0C0C0" Direction="-1,-2,-3" />
                                <DirectionalLight Color="#606060" Direction="1,2,1" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <ModelVisual3D x:Name="ModelHost" />
                </Viewport3D>
                <!-- Transparent overlay captures mouse input for orbiting. -->
                <Border Background="Transparent" MouseLeftButtonDown="View_MouseDown" MouseLeftButtonUp="View_MouseUp"
                        MouseMove="View_MouseMove" MouseWheel="View_MouseWheel" />
                <TextBlock Foreground="#AAA" Margin="10" VerticalAlignment="Bottom" IsHitTestVisible="False"
                           Text="Drag to rotate · scroll to zoom" />
                <TextBlock x:Name="EmptyText" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Text="The generated shape will appear here" />
            </Grid>
        </Border>
    </Grid>
</Window>
